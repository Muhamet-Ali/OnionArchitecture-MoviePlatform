@model MovieApi.Dto.DTOs.RegisterDtos.CreateRegisterDto

@{
    Layout = null;
}



<!DOCTYPE html>

<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MovieHub - Join the Community</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#a413ec",
                        "background-light": "#f7f6f8",
                        "background-dark": "#1c1022",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        .glass-card {
            background: rgba(43, 25, 51, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(164, 19, 236, 0.2)
        }

        .film-grain {
            position: relative
        }

            .film-grain::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: url(https://lh3.googleusercontent.com/aida-public/AB6AXuAoJskL4qIywPRSPlUEw41FQpbuuFO0kHwuOcrokkDlDaUvUvK1i0vapwE5p7spnhKpCLsmRd0pbt51HeiQbljwikxYjhVHQYa64qHxwvrrOhwMOBTNilZFd2eMsWKx-yatPvzVM7mudAGYegAQKsml3VqoCPPZMLXpJlDhqo3Dps39ok8I0Vc7IArA4JzmNUtIUO8FzM4WD4yp0t_sPCLkMej8aAIMhhQovrhAJH0fKW69bpcgsj0sf6Lqh4kvXhSo0RW_ITnnBPEu);
                opacity: 0.05;
                pointer-events: none
            }

        .hero-gradient {
            background: linear-gradient(to right, rgba(28, 16, 34, 0) 0%, rgba(28, 16, 34, 1) 100%)
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 antialiased min-h-screen">
    <div class="flex min-h-screen w-full flex-col lg:flex-row overflow-hidden">
        <div class="hidden lg:flex lg:w-3/5 relative film-grain overflow-hidden">
            <div class="absolute inset-0 bg-cover bg-center" data-alt="Cinematic wide shot of a classic cinema theater interior" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuCnk4r6bvN7lDT89-4F3xL8mhDoRvjsOjwBsJky07jPvuRmsrMr7lKWJYFqZy78iX8saC2IM19ssdUYPgolkce2HRXtWyTekq5sgQZ6cAv3bteNz1L8mahnRJsz6loWFrgM-MGoAoHKNBWf0Gau6a2CyIzr2GJtJt1rB4KYZZ7AL1yfTPthUDVTeb0SrKZx7oJqFWN-FvPc2S3209_2lnHdoWcT81lpFU-1-eU2sPqKLbEapmXbjmTSxqxKYs-27R_jPxu_H36babc0");'></div>
            <div class="absolute inset-0 bg-primary/20 backdrop-blur-sm"></div>
            <div class="absolute inset-0 hero-gradient"></div>
            <div class="relative z-10 flex flex-col justify-center px-16 h-full max-w-2xl">
                <div class="flex items-center gap-2 mb-6 text-primary">
                    <span class="material-symbols-outlined text-5xl">movie</span>
                    <h1 class="text-white text-5xl font-black tracking-tighter">MOVIEHUB</h1>
                </div>
                @if(ViewBag!=null)
                    {<h1 style="color:red">@ViewBag.ErrorMessage</h1>}
                <h2 class="text-white text-6xl font-black leading-tight mb-4 tracking-tight">
                    Your cinema journey <span class="text-primary">starts here.</span>
                </h2>
                <p class="text-slate-300 text-xl font-medium leading-relaxed">
                    Track your watchlist, share reviews with friends, and discover your next favorite film in the world's most vibrant community.
                </p>
                <div class="mt-12 flex gap-8 items-center">
                    <div class="flex flex-col">
                        <span class="text-3xl font-bold text-white tracking-tight">24M+</span>
                        <span class="text-sm text-slate-400 uppercase tracking-widest">Reviews</span>
                    </div>
                    <div class="w-px h-10 bg-slate-700"></div>
                    <div class="flex flex-col">
                        <span class="text-3xl font-bold text-white tracking-tight">500K+</span>
                        <span class="text-sm text-slate-400 uppercase tracking-widest">Movies</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex-1 flex flex-col items-center justify-center p-6 lg:p-12 relative z-20">
            <div class="w-full max-w-md glass-card rounded-xl p-8 shadow-2xl">
                <div class="lg:hidden flex items-center gap-2 mb-8">
                    <span class="material-symbols-outlined text-3xl text-primary">movie</span>
                    <span class="text-white text-2xl font-black tracking-tighter">MOVIEHUB</span>
                </div>
                <div class="mb-8">
                    <h3 class="text-2xl font-bold text-white mb-2">Create Account</h3>
                    <p class="text-slate-400">Join the community and start tracking.</p>
                </div>

                <form method="post" asp-controller="Register" asp-action="Signup" class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Name" class="text-slate-200 text-sm font-medium px-1">First Name</label>
                            <input asp-for="Name" class="w-full rounded-lg bg-background-dark/50 border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary text-white p-3 outline-none transition-all placeholder:text-slate-600" placeholder="John" />
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label asp-for="Surname" class="text-slate-200 text-sm font-medium px-1">Last Name</label>
                            <input asp-for="Surname" class="w-full rounded-lg bg-background-dark/50 border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary text-white p-3 outline-none transition-all placeholder:text-slate-600" placeholder="Doe" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="UserName" class="text-slate-200 text-sm font-medium px-1">Username</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xl">alternate_email</span>
                            <input asp-for="UserName" class="w-full rounded-lg bg-background-dark/50 border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary text-white p-3 pl-10 outline-none transition-all placeholder:text-slate-600" placeholder="johndoe123" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Email" class="text-slate-200 text-sm font-medium px-1">Email Address</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xl">mail</span>
                            <input asp-for="Email" class="w-full rounded-lg bg-background-dark/50 border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary text-white p-3 pl-10 outline-none transition-all placeholder:text-slate-600" placeholder="john@example.com" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Password" class="text-slate-200 text-sm font-medium px-1">Password</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xl">lock</span>
                            <input asp-for="Password" class="w-full rounded-lg bg-background-dark/50 border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary text-white p-3 pl-10 outline-none transition-all placeholder:text-slate-600" placeholder="••••••••" />
                        </div>
                        <p class="text-[10px] text-slate-500 mt-1 px-1 uppercase tracking-wider font-bold">Minimum 8 characters with one special symbol</p>
                    </div>
                    <div class="pt-4">
                        <button class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-lg shadow-lg shadow-primary/20 transition-all flex items-center justify-center gap-2 group" type="submit">
                            <span>Get Started</span>
                            <span class="material-symbols-outlined text-xl group-hover:translate-x-1 transition-transform">arrow_forward</span>
                        </button>
                    </div>
                </form>
                <div class="mt-8 pt-6 border-t border-slate-700/50 text-center">
                    <p class="text-slate-400 text-sm">
                        Already have an account?
                        <a class="text-primary font-bold hover:underline underline-offset-4 ml-1" asp-controller="Login" asp-action="SignIn">Sign in</a>
                    </p>
                </div>
                <div class="mt-6 flex justify-center gap-4">
                    <button class="p-2 rounded-full border border-slate-700 hover:bg-slate-700/50 transition-colors text-slate-400" title="Sign up with Google">
                        <svg class="w-5 h-5" fill="currentColor" viewbox="0 0 24 24"><path d="M12.48 10.92v3.28h7.84c-.24 1.84-.9 3.34-1.92 4.42-1.2 1.2-3.08 2.48-5.92 2.48-4.57 0-8.21-3.7-8.21-8.27s3.64-8.27 8.21-8.27c2.47 0 4.29 1.01 5.62 2.27l2.32-2.32C18.49 2.5 15.77 1 12.48 1 6.5 1 1.63 5.8 1.63 11.78S6.5 22.56 12.48 22.56c3.23 0 5.67-1.07 7.56-3.07 1.94-1.94 2.55-4.66 2.55-6.89 0-.66-.05-1.29-.14-1.88h-9.97z"></path></svg>
                    </button>
                    <button class="p-2 rounded-full border border-slate-700 hover:bg-slate-700/50 transition-colors text-slate-400" title="Sign up with Apple">
                        <svg class="w-5 h-5" fill="currentColor" viewbox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05 1.78-3.19 1.76-1.14-.02-1.5-.72-2.82-.72s-1.72.7-2.82.74c-1.12.04-2.21-.83-3.2-1.78-2.02-1.94-3.57-5.49-1.54-9.01.99-1.74 2.78-2.85 4.73-2.88 1.48-.02 2.88 1.01 3.79 1.01.9 0 2.59-1.23 4.34-1.05.74.03 2.8.3 4.12 2.23-.11.06-2.45 1.43-2.42 4.23.03 3.35 2.92 4.5 2.95 4.51-.03.07-.46 1.58-1.52 2.96zM12.03 5.41c.82-1.01 1.37-2.4 1.22-3.8-1.21.05-2.67.81-3.54 1.82-.78.89-1.46 2.33-1.28 3.7 1.35.1 2.73-.64 3.6-1.72z"></path></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

