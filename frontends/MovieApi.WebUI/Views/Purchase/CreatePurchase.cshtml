@{
    ViewData["Title"] = "CreatePurchase";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<div class="page-single">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <br /><br /><br />
                <div style="position:relative; overflow:hidden; padding: 40px 0;">

                    <div style="max-width:600px; margin:0 auto;">

                        <div style="margin-bottom:20px; display:flex; align-items:center; gap:10px; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.2); color:#6ee7b7; padding:12px 16px; border-radius:8px;">
                            <i class="ion-checkmark-circled"></i>
                            <span style="font-size:13px; font-weight:600;">Ready to stream in 4K Ultra HD</span>
                        </div>

                        <div style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:12px; overflow:hidden; box-shadow:0 25px 50px rgba(0,0,0,0.4);">

                            <div style="position:relative; height:200px; width:100%;">
                                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuACBpdr6ZWoiU3Vs2v8eSl-uyDrH-rJukWJnte1HXmVa9esQmNWhRS7MG7gUMWLMQxTlU5VlUEQh2dIUTss3yI5sywiW-pMYWjJJ57njiYf2pjk3He_GmARoo3jYVYqIoQr_zleR_5ViyF281NhUY99rtZUHlGwRWQZtInmCKGFBoxQIi4CzEFoHfFCATieGxfuRhT0E4DoSgg7TAz9DYlweC8WAx8mI5mLBT2Wod0mFQ8WkCPNkZuqMXLnS0HkrPzNWHhQ4yyafiDH"
                                     style="width:100%; height:100%; object-fit:cover; opacity:0.6;" alt="">
                                <div style="position:absolute; inset:0; background:linear-gradient(to top, #1a1a2e, transparent);"></div>
                                <div style="position:absolute; bottom:16px; left:24px;">
                                    <span style="background:#a413ec; padding:3px 10px; border-radius:4px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:2px; color:#fff; display:inline-block; margin-bottom:8px;">Movie</span>
                                    <h1 style="color:#fff; font-size:28px; font-weight:700; margin:0; line-height:1;">Interstellar</h1>
                                </div>
                            </div>

                            <div style="padding:32px;">

                                <div style="margin-bottom:24px;">
                                    <div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:16px; border-bottom:1px solid rgba(255,255,255,0.1); margin-bottom:16px;">
                                        <span style="color:#94a3b8; font-weight:500;">Resolution</span>
                                        <span style="color:#fff;">4K / HDR10+</span>
                                    </div>
                                    <div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:16px; border-bottom:1px solid rgba(255,255,255,0.1); margin-bottom:16px;">
                                        <span style="color:#94a3b8; font-weight:500;">Audio</span>
                                        <span style="color:#fff;">Dolby Atmos</span>
                                    </div>
                                    <div style="display:flex; justify-content:space-between; align-items:center; padding-top:8px;">
                                        <span style="color:#f1f5f9; font-weight:700; font-size:18px;">Total</span>
                                        <span style="color:#a413ec; font-weight:700; font-size:24px;">$14.99</span>
                                    </div>
                                </div>

                                <div style="background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:16px; display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
                                    <div style="display:flex; align-items:center; gap:12px;">
                                        <i class="ion-card" style="color:#94a3b8; font-size:20px;"></i>
                                        <div>
                                            <p style="font-size:10px; color:#64748b; text-transform:uppercase; font-weight:700; margin:0;">Payment Method</p>
                                            <p style="font-size:14px; color:#e2e8f0; margin:0;">Visa ending in •••• 4242</p>
                                        </div>
                                    </div>
                                    <a href="#" style="font-size:12px; color:#a413ec; font-weight:700;">Change</a>
                                </div>

                                <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:24px;">
                                    
                                    <a asp-controller="MyProgram" asp-action="MyProgramList" style="width:100%; background:transparent; border:1px solid rgba(255,255,255,0.1); color:#94a3b8; font-weight:500; padding:12px; border-radius:10px; cursor:pointer;">
                                        Cancel
                                    </a>
                                </div>

                                <div style="display:flex; align-items:center; justify-content:center; gap:6px; color:#475569; font-size:10px; text-transform:uppercase; letter-spacing:2px;">
                                    <i class="ion-locked" style="font-size:12px;"></i>
                                    Secure Encrypted Transaction
                                </div>

                            </div>
                        </div>

                        <div style="margin-top:24px; text-align:center;">
                            <a onclick="history.back()" style="display:inline-flex; align-items:center; gap:6px; color:#64748b; font-size:13px; font-weight:500; cursor:pointer; text-decoration:none;">
                                <i class="ion-arrow-left-c"></i>
                                Back to movie details
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
