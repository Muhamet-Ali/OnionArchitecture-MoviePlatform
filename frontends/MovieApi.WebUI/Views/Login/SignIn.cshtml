@model ReultLoginDto
@{
    Layout = null;
}

<!DOCTYPE html>

<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MovieHub Cinematic Login</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#a413ec",
                        "background-light": "#f7f6f8",
                        "background-dark": "#0B0F17",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        body {
            font-family: "Inter", sans-serif
        }

        .cinematic-overlay {
            background: linear-gradient(to right, rgba(11, 15, 23, 0.4), rgba(11, 15, 23, 1))
        }

        .glass-card {
            background: rgba(17, 24, 39, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(164, 19, 236, 0.2)
        }

        .film-grain {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 50;
            opacity: 0.03;
            background-image: url(https://lh3.googleusercontent.com/aida-public/AB6AXuD0JQ8jUXGoCakrh8P2gexml_njv7fbbkbJHACRHnsJIiRTXLfGIwff4xgIKZP0LAeFcTMiVrv5Ku4isa_C_2xwMbvwCluule8UAG83yA3iFWyhpJNyl_uKERFh3kNznaDKhZepE0J1uu9jt7nQd7LKRKmb8PzDqqO1tvF7xlyPwMNZodA7ChnWvH2UULGN2ORZB3aGE-IgIcnHbWm5mi6FmPEdeXxwQ3qH2C6U5KpFgiqxI5tQqkNmsUGrHfMa7lpTMkR7TBtHuPil)
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen font-display overflow-hidden">
    <div class="film-grain"></div>
    <main class="flex h-screen w-full">
        <!-- Sol Taraf -->
        <section class="hidden lg:flex lg:w-3/5 relative overflow-hidden bg-slate-950">
            <div class="absolute inset-0 bg-cover bg-center scale-105 blur-[2px]"
                 style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAvJr5jktYRfDKoUGhL3Kj3XtFXIPfrB3GvD7IC_bdjuyh2FJGHx-r9OUp6oOvCKwQ_gAWUp0XH7JSbiwvAh0TQuch5GEJF4mAGGLW2q2vpxUyPNac8whOe1iPx_bUBoXCYmaRAwM6JHH2m36BUDGfoV_0y0AVLGWyYQPP5IOtqlPJ8AnswbMIcSRXR_HYWqGipKbcesAMu6vWlDrcRfz7yOyH0hQJxJjbS2bj67MGB5GFCksUSSY6fEwRNfjrRyk2hTdYDblOqA2jf');">
            </div>
            <div class="absolute inset-0 cinematic-overlay"></div>
            <div class="relative z-10 flex flex-col justify-between p-16 w-full">
                <div class="flex items-center gap-3">
                    <div class="bg-primary p-2 rounded-lg shadow-[0_0_20px_rgba(164,19,236,0.5)]">
                        <span class="material-symbols-outlined text-white text-3xl">movie</span>
                    </div>
                    <div>
                        <h1 class="text-3xl font-black tracking-tighter text-white uppercase">MOVIEHUB</h1>
                        <p class="text-slate-400 text-sm font-medium tracking-widest uppercase">Track. Watch. Review.</p>
                    </div>
                </div>
                <div class="max-w-md">
                    <h2 class="text-5xl font-extrabold text-white leading-tight mb-4">The ultimate cinematic experience starts here.</h2>
                    <p class="text-slate-300 text-lg leading-relaxed">Join millions of cinephiles tracking their journey through the world of film and television.</p>
                </div>
                <div class="flex gap-4 text-xs font-semibold text-slate-500 uppercase tracking-widest">
                    <span>Exclusive Content</span>
                    <span class="text-primary">•</span>
                    <span>HD Streaming</span>
                    <span class="text-primary">•</span>
                    <span>Community Ratings</span>
                </div>
            </div>
        </section>

        <!-- Sağ Taraf: Form -->
        <section class="w-full lg:w-2/5 flex flex-col items-center justify-center p-8 lg:p-16 bg-background-dark relative">
            <div class="lg:hidden absolute top-8 left-8 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-2xl">movie</span>
                <span class="font-black text-xl tracking-tighter text-white">MOVIEHUB</span>
            </div>
            <div class="w-full max-w-md glass-card p-8 lg:p-10 rounded-xl shadow-2xl">
                <div class="mb-8">
                    <h2 class="text-3xl font-bold text-white mb-2">Welcome back</h2>
                    <p class="text-slate-400">Login to rate movies and sync your watchlist</p>
                </div>

                <form method="post" asp-controller="Login" asp-action="SignIn" class="space-y-5">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <!-- Email -->
                    <div class="space-y-2">
                        <label asp-for="Email" class="block text-sm font-medium text-slate-300 ml-1">Email Address</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-500 group-focus-within:text-primary transition-colors">
                                <span class="material-symbols-outlined text-xl">mail</span>
                            </div>
                            <input asp-for="Email" class="block w-full pl-11 pr-4 py-3.5 bg-slate-900/50 border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all" placeholder="name@example.com" />
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-center ml-1">
                            <label asp-for="Password" class="text-sm font-medium text-slate-300">Password</label>
                            <a class="text-xs font-semibold text-primary hover:text-primary/80 transition-colors" href="#">Forgot password?</a>
                        </div>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-500 group-focus-within:text-primary transition-colors">
                                <span class="material-symbols-outlined text-xl">lock</span>
                            </div>
                            <input asp-for="Password" class="block w-full pl-11 pr-12 py-3.5 bg-slate-900/50 border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all" placeholder="••••••••" />
                            <button class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-500 hover:text-slate-300" type="button">
                                <span class="material-symbols-outlined text-xl">visibility</span>
                            </button>
                        </div>
                    </div>

                    <!-- Remember Me -->
                    <div class="flex items-center gap-3 py-1">
                        <input class="w-5 h-5 rounded border-slate-800 bg-slate-900 text-primary focus:ring-primary focus:ring-offset-background-dark cursor-pointer" id="remember" type="checkbox" />
                        <label class="text-sm text-slate-400 cursor-pointer select-none" for="remember">Remember this device</label>
                    </div>

                    <!-- Sign In Button -->
                    <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-xl shadow-[0_10px_20px_-10px_rgba(164,19,236,0.5)] transition-all transform active:scale-[0.98]">
                        Sign in
                    </button>
                    <button onclick="history.back()" type="button" class="w-full bg-transparent hover:bg-white/10 text-white font-bold py-4 rounded-xl border border-white/20 transition-all transform active:scale-[0.98] mt-3">
                        Cancel
                    </button>
                </form>

                <div class="relative my-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-800"></div>
                    </div>
                    <div class="relative flex justify-center text-xs uppercase">
                        <span class="bg-[#111827] px-4 text-slate-500 font-medium tracking-widest">Or continue with</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <button class="flex items-center justify-center gap-2 py-3 px-4 border border-slate-700 rounded-xl hover:bg-slate-800/50 text-white font-medium transition-all">
                        <svg class="w-5 h-5" viewbox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="currentColor"></path>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="currentColor"></path>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="currentColor"></path>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.66l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 12-4.53z" fill="currentColor"></path>
                        </svg>
                        Google
                    </button>
                    <button class="flex items-center justify-center gap-2 py-3 px-4 border border-slate-700 rounded-xl hover:bg-slate-800/50 text-white font-medium transition-all">
                        <svg class="w-5 h-5" viewbox="0 0 24 24">
                            <path d="M17.05 20.28c-.96.95-2.05 1.72-3.25 1.72-1.2 0-1.6-.72-3.1-.72s-1.95.72-3.1.72c-1.2 0-2.35-.85-3.25-1.72-1.9-1.9-3.25-5.4-3.25-8.45 0-4.65 3.05-7.1 5.9-7.1 1.45 0 2.5.95 3.45.95s2-.95 3.45-.95c2.25 0 4.15 1.35 5.1 3.1-4.05 1.8-3.4 7.6.65 9.35zM12 4.45c0-1.9 1.55-3.45 3.45-3.45 0 1.9-1.55 3.45-3.45 3.45z" fill="currentColor"></path>
                        </svg>
                        Apple
                    </button>
                </div>

                <div class="mt-8 text-center">
                    <p class="text-sm text-slate-500">
                        New to MovieHub? <a class="text-primary font-bold hover:underline" asp-controller="Register" asp-action="Signup">Create an account</a>
                    </p>
                </div>
            </div>

            <footer class="absolute bottom-8 w-full px-8 text-center lg:text-left">
                <div class="flex flex-col lg:flex-row justify-center lg:justify-between items-center gap-4 text-[10px] text-slate-600 uppercase tracking-widest font-semibold">
                    <span>© 2024 MOVIEHUB GLOBAL INC.</span>
                    <div class="flex gap-6">
                        <a class="hover:text-slate-400 transition-colors" href="#">Privacy Policy</a>
                        <a class="hover:text-slate-400 transition-colors" href="#">Terms of Service</a>
                        <a class="hover:text-slate-400 transition-colors" href="#">Help Center</a>
                    </div>
                </div>
            </footer>
        </section>
    </main>
</body>
</html>
