@model CreateAdminEpisodeDto

@{
    ViewData["Title"] = "CreateEpisode";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}


<style>
    :root {
        --primary: #6366f1;
        --success: #10b981;
        --bg-soft: #f8fafc;
        --text-dark: #1f2937;
        --text-muted: #6b7280;
        --radius: 12px;
    }

    .admin-card {
        background: #fff;
        border-radius: var(--radius);
        padding: 24px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
    }

    .page-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-card {
        background: #fff;
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: 0 4px 12px rgba(0,0,0,.03);
        height: 100%;
    }

        .form-card h6 {
            font-weight: 700;
            margin-bottom: 16px;
            color: var(--text-dark);
        }

    .form-group label {
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
        color: var(--text-dark);
    }

    .form-control-modern {
        width: 100%;
        padding: 12px 14px;
        border-radius: var(--radius);
        border: 1px solid #e5e7eb;
        background: var(--bg-soft);
    }

        .form-control-modern:focus {
            outline: none;
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(99,102,241,.15);
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 20px;
    }

    .btn-primary-soft {
        background: var(--primary);
        color: #fff;
        padding: 10px 20px;
        border-radius: var(--radius);
        font-weight: 600;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-secondary-soft {
        background: #e5e7eb;
        color: #374151;
        padding: 10px 20px;
        border-radius: var(--radius);
        text-decoration: none;
        font-weight: 600;
    }

    /* Type Toggle */
    .type-toggle {
        display: flex;
        gap: 0;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid #e5e7eb;
        margin-bottom: 20px;
    }

        .type-toggle input[type="radio"] {
            display: none;
        }

        .type-toggle label {
            flex: 1;
            text-align: center;
            padding: 11px 0;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            background: var(--bg-soft);
            color: var(--text-muted);
            transition: all 0.18s;
            margin: 0 !important;
            display: flex !important;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

    #type-movie:checked ~ .toggle-labels label[for="type-movie"],
    #type-series:checked ~ .toggle-labels label[for="type-series"] {
        background: var(--primary);
        color: #fff;
    }

    .select-section {
        display: none;
        animation: fadeIn 0.2s ease;
    }

        .select-section.visible {
            display: block;
        }

</style>

<div class="admin-card">
    <div class="page-title">
        🎬 Create New Episode
    </div>

    <form method="post">

        <input type="hidden" asp-for="SeasonId" />


        <div class="row g-4">
            <!-- SOL -->
            <div class="col-lg-8">
                <div class="form-card">
                    <h6>Season Info</h6>

                    <div class="form-group mb-3">
                        <label>Season Title</label>
                        <input asp-for="Title" class="form-control-modern" />
                    </div>

                    <div class="form-group mb-3">
                        <label>Description</label>
                        <textarea asp-for="Description" rows="5" class="form-control-modern"></textarea>
                    </div>

                    
                </div>
            </div>

            <!-- SAĞ -->
            <div class="col-lg-4">
                <div class="form-card">
                    <h6>Meta Info</h6>

                    <div class="form-group mb-3">
                        <label>Season Number</label>
                        <input asp-for="EpisodeNumber" type="number" class="form-control-modern" />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a href="javascript:history.back()" class="btn-back" class="btn btn-outline-danger">← Back to List</a>

            <button type="submit" class="btn-primary-soft">
                <ion-icon name="save-outline"></ion-icon>
                Create
            </button>
        </div>
    </form>
</div>

