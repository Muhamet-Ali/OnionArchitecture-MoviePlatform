@model UpdateAdminCastDto

@{
    ViewData["Title"] = "UpdateCast";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}



<style>
    :root {
        --primary: #6366f1;
        --bg-soft: #f8fafc;
        --text-dark: #1f2937;
        --radius: 12px;
    }

    .admin-card {
        background: #fff;
        border-radius: var(--radius);
        padding: 24px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
    }

    .page-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-card {
        background: #fff;
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: 0 4px 12px rgba(0,0,0,.03);
        height: 100%;
    }

        .form-card h6 {
            font-weight: 700;
            margin-bottom: 16px;
            color: var(--text-dark);
        }

    .form-group label {
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
        color: var(--text-dark);
    }

    .form-control-modern {
        width: 100%;
        padding: 12px 14px;
        border-radius: var(--radius);
        border: 1px solid #e5e7eb;
        background: var(--bg-soft);
    }

        .form-control-modern:focus {
            outline: none;
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(99,102,241,.15);
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 20px;
    }

    .btn-primary-soft {
        background: var(--primary);
        color: #fff;
        padding: 10px 20px;
        border-radius: var(--radius);
        font-weight: 600;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-secondary-soft {
        background: #e5e7eb;
        color: #374151;
        padding: 10px 20px;
        border-radius: var(--radius);
        text-decoration: none;
        font-weight: 600;
    }
</style>

<div class="admin-card">
    <div class="page-title">
        🎭 Create New Cast
    </div>

    <form method="post">
        <div class="row g-4">

            <!-- SOL -->
            <div class="col-lg-8">
                <div class="form-card">
                    <h6>Personal Info</h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Title (Mr/Mrs)</label>
                                <input asp-for="Title" class="form-control-modern" placeholder="Mr, Mrs..." />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Name</label>
                                <input asp-for="Name" class="form-control-modern" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Surname</label>
                                <input asp-for="Surname" class="form-control-modern" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label>Overview</label>
                        <textarea asp-for="OverView" rows="3"
                                  class="form-control-modern"
                                  placeholder="Short description about the cast..."></textarea>
                    </div>

                    <div class="form-group mb-3">
                        <label>Biography</label>
                        <textarea asp-for="Biography" rows="5"
                                  class="form-control-modern"
                                  placeholder="Detailed biography..."></textarea>
                    </div>
                </div>
            </div>

            <!-- SAĞ -->
            <div class="col-lg-4">
                <div class="form-card">
                    <h6>Photo</h6>

                    <div class="form-group mb-3">
                        <label>Image URL</label>
                        <input asp-for="ImageUrl" class="form-control-modern"
                               placeholder="https://..." id="imageUrlInput" />
                    </div>

                    <!-- Preview -->
                    <div style="margin-top:12px; text-align:center;">
                        <img id="imagePreview"
                             src=""
                             alt="Preview"
                             style="width:100%; max-height:220px; object-fit:cover; border-radius:10px; display:none; border:1px solid #e5e7eb;" />
                        <div id="imagePlaceholder"
                             style="width:100%; height:160px; background:#f8fafc; border:1px dashed #e5e7eb; border-radius:10px; display:flex; align-items:center; justify-content:center; color:#94a3b8; font-size:13px;">
                            No image
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="form-actions">
            <a href="javascript:history.back()" class="btn-back" class="btn btn-outline-danger">← Back to List</a>

            <button type="submit" class="btn-primary-soft">
                <ion-icon name="save-outline"></ion-icon>
                Update
            </button>
        </div>
    </form>
</div>
