@model CreateAdminCategoryDto

@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}


<style>
    .card {
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,.08);
        box-shadow: 0 10px 28px rgba(0,0,0,.10)
    }

    .table-responsive {
        border-radius: 12px;
        overflow: hidden
    }

    .table thead.table-secondary {
        background: linear-gradient(90deg,#eef2ff,#e0f2fe)
    }

    .table tbody tr:hover {
        background: #f8fafc
    }

    input.form-control {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,.12)
    }

    .btn {
        border-radius: 10px
    }

    img.rounded-circle {
        object-fit: cover;
        border: 2px solid rgba(0,0,0,.08)
    }
</style>

<div class="card">
    <div class="card-body">
        
        <div class="d-flex align-items-center">
            <h5 class="mb-0">Create Category</h5>
        </div>

        <form class="mt-3"
              asp-area="Admin"
              asp-controller="Category"
              asp-action="CreateCategory"
              method="post">

            <div class="mb-3">
                <label class="form-label">Category Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Action" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Save
                </button>

                <a href="javascript:history.back()" class="btn-back" class="btn btn-outline-danger">← Back to List</a>

            </div>
        </form>
    </div>
</div>