@using MovieApi.Dto.DTOs.AdminSeriesDtos
@model ResultSeriesDto

@{
    ViewData["Title"] = "DetailSeries";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .detail-wrapper {
        padding: 32px;
        max-width: 1100px;
    }

    .page-title {
        font-size: 22px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .movie-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.08);
        overflow: hidden;
        display: flex;
        gap: 0;
    }

    .movie-poster {
        width: 260px;
        min-height: 360px;
        flex-shrink: 0;
        background: #0f172a;
        position: relative;
    }

        .movie-poster img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .movie-poster .rating-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(15,23,42,0.82);
            color: #facc15;
            font-size: 13px;
            font-weight: 700;
            padding: 5px 11px;
            border-radius: 20px;
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            gap: 5px;
        }

    .movie-info {
        flex: 1;
        padding: 32px 36px;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .movie-title {
        font-size: 26px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }

    .movie-category {
        font-size: 13px;
        color: #6366f1;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 18px;
    }

    .movie-description {
        font-size: 14px;
        color: #475569;
        line-height: 1.7;
        margin-bottom: 28px;
        max-width: 580px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 28px;
    }

    .stat-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px 16px;
        text-align: center;
    }

        .stat-box .stat-label {
            font-size: 11px;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .stat-box .stat-value {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
        }

    .meta-row {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        font-size: 13px;
        color: #64748b;
        margin-bottom: 24px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .meta-item span.label {
            font-weight: 600;
            color: #334155;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

        .status-pill.active {
            background: #dcfce7;
            color: #16a34a;
        }

        .status-pill.inactive {
            background: #fee2e2;
            color: #dc2626;
        }

    .action-buttons {
        display: flex;
        gap: 10px;
        margin-top: auto;
        padding-top: 10px;
        border-top: 1px solid #f1f5f9;
    }

    .btn-edit {
        padding: 9px 22px;
        background: #6366f1;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.18s;
    }

        .btn-edit:hover {
            background: #4f46e5;
            color: #fff;
        }

    .btn-back {
        padding: 9px 22px;
        background: #f1f5f9;
        color: #475569;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.18s;
    }

        .btn-back:hover {
            background: #e2e8f0;
            color: #1e293b;
        }
</style>

<div class="detail-wrapper">
    <div class="page-title">
        🎬 Series Detail
    </div>

    <div class="movie-card">
        <div class="movie-poster">
            <img src="@Model.CoverImageUrl" alt="@Model.Title" onerror="this.src='/images/no-poster.png'" />
            <div class="rating-badge">
                ⭐ @Model.Rating.ToString("0.0")
            </div>
        </div>

        <div class="movie-info">
            <div class="movie-title">@Model.Title</div>
            <div class="movie-category">@Model.CategoryName</div>
            <div class="movie-description">@Model.Description</div>

            <div class="stats-grid">
               
                <div class="stat-box">
                    <div class="stat-label">Seasons</div>
                    <div class="stat-value">@Model.SeasonsCount</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Episodes</div>
                    <div class="stat-value">@Model.EpisodesCount</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Reviews</div>
                    <div class="stat-value">@Model.ReviewCount</div>
                </div>
            </div>

            <div class="meta-row">
                <div class="meta-item">
                    <span class="label">Average Episode Duration:</span> @Model.AverageEpisodeDuration
                </div>
                <div class="meta-item">
                    🗓️ <span class="label">Year:</span> @Model.FirstAirDate
                </div>

                <div class="meta-item">
                    <span class="status-pill @(Model.Status ? "active" : "inactive")">
                        @(Model.Status ? "● Active" : "● Inactive")
                    </span>
                </div>
            </div>

            <div class="action-buttons">
                <a asp-area="Admin" asp-controller="Cast" asp-action="CastSeriesList" asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">Show Casts</a>
                
                   <a asp-area="Admin" asp-controller="Review" asp-action="GetSeriesReviewById" asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">Show Reviews</a>

                <a href="javascript:history.back()" class="btn-back">← Back to List</a>
            </div>
        </div>
    </div>
</div>